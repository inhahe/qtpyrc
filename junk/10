def _vlinear(v):
  if v <= .04045:
    return v / 12.92
  return ((v + .055) / 1.055) ** 2.4

def _luminance(r, g, b):
  return _vlinear(r) * .2126 + _vlinear(g) * .7152 + _vlinear(b) * .0722

def perceivedbrightness(r, g, b):
  r, g, b = r / 255, g / 255, b / 255
  y = _luminance(r, g, b)
  if y <= 216 / 24389:
    return y * 24389 / 27
  return y ** (1/3) * 116 - 16

