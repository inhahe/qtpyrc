      btn = QPushButton()
      btn.setFixedSize(20, 20)
      c = QColor(qt_color)
      btn.setStyleSheet("background-color: %s; border: 1px solid #888;" % c.name())
      btn.setToolTip(name)
      btn.clicked.connect(lambda checked, clr=c: self.set_color(clr))
