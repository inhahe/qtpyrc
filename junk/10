def loadconfig(configpath):
  yaml = YAML()
  yaml.preserve_quotes = True
  with open(configpath, 'r') as f:
    data = yaml.load(f)
  cfg = AppConfig(configpath, data, yaml)
  _update_text_formats(cfg)
  return cfg

